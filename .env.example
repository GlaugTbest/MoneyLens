# --- Database ---
DATABASE_URL=postgresql://moneylens:moneylens@localhost:5434/moneylens
POSTGRES_DB=moneylens
POSTGRES_USER=moneylens
POSTGRES_PASSWORD=moneylens

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Auth (generate your own random strings, e.g. `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Pluggy (https://dashboard.pluggy.ai) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_WEBHOOK_URL=https://<your-ngrok-subdomain>.ngrok-free.app/api/webhooks/pluggy
PLUGGY_WEBHOOK_SECRET=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ENABLE_LLM_CATEGORIZATION=true

# --- ngrok (https://dashboard.ngrok.com) ---
NGROK_AUTHTOKEN=

# --- API ---
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
